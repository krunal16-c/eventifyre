# ── AI agents ────────────────────────────────────────────────
# Without a key the platform runs its offline simulator (scripted agents).
ANTHROPIC_API_KEY=
EVENTIFYRE_MODEL=claude-opus-5-5
EVENTIFYRE_AGENT_EFFORT=medium        # low | medium | high | xhigh | max
EVENTIFYRE_MAX_AGENT_TURNS=12
EVENTIFYRE_AGENT_CONCURRENCY=4
# EVENTIFYRE_OFFLINE=true             # force the simulator even with a key

# ── Communications ───────────────────────────────────────────
# Nothing is sent to real people unless COMMS_LIVE=true.
COMMS_LIVE=false
PUBLIC_BASE_URL=http://localhost:3000  # must be publicly reachable for Twilio webhooks

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Eventifyre Agents <agents@yourdomain.com>"
EMAIL_REPLY_DOMAIN=                    # e.g. reply.yourdomain.com (inbound routing)
WEBHOOK_SECRET=                        # shared secret for /webhooks/email/inbound

# SMS + voice (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Vendor discovery ─────────────────────────────────────────
GOOGLE_PLACES_API_KEY=

PORT=3000
DATA_DIR=data
